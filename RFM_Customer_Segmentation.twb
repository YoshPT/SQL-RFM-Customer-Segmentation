      </column>
      <column caption='Customer %' datatype='real' default-format='p0.0%' name='[Calculation_291467338768412674]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([customer_id]) / TOTAL(COUNTD([customer_id]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Revenue %' datatype='real' default-format='p0.0%' name='[Calculation_291467338768494595]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Monetary]) / TOTAL(SUM([Monetary]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Top Tier Rev %' datatype='real' name='[Calculation_291467338768556036]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Customer_Segment]=&quot;Champions&quot; OR [Customer_Segment]=&quot;Loyal Customers&quot; THEN [Monetary] END) / SUM([Monetary])' />
      </column>
      <column caption='At Risk Revenue' datatype='real' name='[Calculation_291467338768625669]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Customer_Segment]=&quot;At Risk&quot; THEN [Monetary] END)' />
      </column>
      <column caption='dynamic' datatype='string' name='[Calculation_316940824200347648]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND([Calculation_291467338768556036]*100,1)) + &quot;%&quot;' />
